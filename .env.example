# ===== 服务配置 =====
# 服务监听端口（云托管控制台里通常设为 80）
PORT=3000

# JWT 签名密钥（务必改成随机长字符串！）
JWT_SECRET=please-change-to-a-long-random-string
# 登录态有效期
JWT_EXPIRES_IN=7d

# ===== 数据库配置 =====
# 驱动：mysql=生产（云托管内置MySQL）；memory=本地开发演示（重启丢数据）
# 不设置时：有 DB_HOST 自动用 mysql，否则用 memory
DB_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=construction_safety

# ===== 数据保留 =====
# 原小程序每 7 天清空一次上报数据；这里默认 0=永久保留，想复刻原逻辑设 7
DATA_RETENTION_DAYS=0
